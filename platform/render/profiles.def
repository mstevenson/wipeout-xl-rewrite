/* ID, profile member (also the module prefix), native size, Original cadence, and Original interpolation. */
RENDER_PROFILE(RENDER_PS1,    ps1,    320, 240, 256, 30, 25, 0)
RENDER_PROFILE(RENDER_PC,     pc,     640, 480, 480, 60, 60, 1)
RENDER_PROFILE(RENDER_N64,    n64,    320, 240, 240, 30, 30, 1)
RENDER_PROFILE(RENDER_SATURN, saturn, 352, 240, 240, 20, 20, 1)
RENDER_PROFILE(RENDER_MODERN, modern, 320, 240, 256, 60, 60, 1)
